MONGODB_URI=
AUTH_SECRET=
SITE_URL=http://localhost:3000
SEED_ADMIN_EMAIL=admin@godpuja.com
SEED_ADMIN_PASSWORD=ChangeMe!12345
# Cloudinary (media library, Stage 6 - not used yet)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public customer sign-up endpoint (/api/auth/register). Keep "false" until the storefront has account pages.
ALLOW_PUBLIC_REGISTRATION=false

# Client IP for rate limiting (Stage 11). Default: the X-Forwarded-For entry added by ONE trusted proxy (Vercel, nginx).
# Behind CDN + load balancer use 2. Or name a header your edge overwrites on every request (e.g. cf-connecting-ip).
TRUSTED_PROXY_HOPS=1
CLIENT_IP_HEADER=
# SITE_URL must be the real https origin when building for production: HSTS and upgrade-insecure-requests are only
# emitted for https sites, and canonicals/sitemap use it.

# Stage 12 (PRD v1.1 global): ISO countries we deliver to (comma-separated) and the admin reporting time zone.
SHIPPING_COUNTRIES=IN
ADMIN_TIMEZONE=Asia/Kolkata

MONGODB_URI=
AUTH_SECRET=
SITE_URL=http://localhost:3000
SEED_ADMIN_EMAIL=admin@godpuja.com
SEED_ADMIN_PASSWORD=ChangeMe!12345
# Cloudinary (media library, Stage 6 - not used yet)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public customer sign-up (/register, /api/auth/register). Open by default since Stage 13; "false" closes it.
ALLOW_PUBLIC_REGISTRATION=true

# Client IP for rate limiting (Stage 11). Default: the X-Forwarded-For entry added by ONE trusted proxy (Vercel, nginx).
# Behind CDN + load balancer use 2. Or name a header your edge overwrites on every request (e.g. cf-connecting-ip).
TRUSTED_PROXY_HOPS=1
CLIENT_IP_HEADER=
# SITE_URL must be the real https origin when building for production: HSTS and upgrade-insecure-requests are only
# emitted for https sites, and canonicals/sitemap use it.

# Stage 12 (PRD v1.1 global): ISO countries we deliver to (comma-separated) and the admin reporting time zone.
SHIPPING_COUNTRIES=IN
ADMIN_TIMEZONE=Asia/Kolkata

# Stage 13: transactional email via Resend (https://resend.com). Without both, emails are logged as "skipped"
# and printed to the server console in development (so verification/reset links still work locally).
RESEND_API_KEY=
EMAIL_FROM="GodPuja <orders@your-verified-domain.com>"
# "Continue with Google" (OAuth client of type "Web application"). Without both, the button is hidden.
# Authorised redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
